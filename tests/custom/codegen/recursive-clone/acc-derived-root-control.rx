use rx::core::*;

#[derive(Clone, PartialEq, Eq)]
struct Node {
    value: i32,
    children: Vec<Self>,
}
fn leaf(value: i32) -> Node {
    Node {
        value: value,
        children: Vec::<Node>::new(),
    }
}

fn main() {
    let mut original = leaf(17);
    original.children.push(leaf(19));
    let mut copy = original.clone();
    copy.children[0].value = 23;
    println_i32(original.children[0].value);
    println_i32(copy.children[0].value);
    println_i32((original != copy) as i32);
}
