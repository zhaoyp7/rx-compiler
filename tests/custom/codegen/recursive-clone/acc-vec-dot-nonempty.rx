use rx::core::*;

#[derive(Clone, PartialEq, Eq)]
struct Node {
    value: i32,
    children: Vec<Self>,
}
fn leaf(value: i32) -> Node {
    Node {
        value: value,
        children: Vec::<Node>::new(),
    }
}

fn main() {
    let mut original = Vec::<Node>::new();
    let mut child = leaf(17);
    child.children.push(leaf(19));
    original.push(child);
    let mut copy = original.clone();
    println_i32(copy.len() as i32);
    println_i32((original == copy) as i32);
    copy[0].value = 23;
    copy[0].children[0].value = 29;
    println_i32(original[0].value);
    println_i32(copy[0].value);
    println_i32(original[0].children[0].value);
    println_i32(copy[0].children[0].value);
    println_i32((original == copy) as i32);
}
