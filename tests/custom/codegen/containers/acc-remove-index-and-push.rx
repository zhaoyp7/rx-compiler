use rx::core::*;

fn main() {
    let mut v = Vec::<i32>::new();
    v.push(11);
    v.push(22);
    v.push(33);
    v.push(44);
    let index = get_i32() as usize;
    println_i32(v.remove(index));
    v.push(55);
    println_i32(v.len() as i32);
    let mut i = 0usize;
    while i < v.len() {
        println_i32(v[i]);
        i += 1usize;
    }
}
