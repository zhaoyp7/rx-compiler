use rx::core::*;

fn single(n: i32) -> Vec<i32> {
    let mut v = Vec::<i32>::new();
    v.push(n);
    v
}
fn main() {
    let mut v = Vec::<Vec<i32>>::new();
    v.push(single(11));
    v.push(single(22));
    v.push(single(33));
    let removed = v.remove(0);
    println_i32(removed[0]);
    println_i32(v[0][0]);
    println_i32(v[1][0]);
}
