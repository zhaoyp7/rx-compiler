use rx::core::*;

fn main() {
    let mut v = Vec::<i32>::new();
    let mut i = 0;
    while i < 32 {
        v.push(i * i);
        i += 1;
    }
    let mut copy = v.clone();
    copy[31] = 17;
    println_i32(v.len() as i32);
    println_i32(v[0]);
    println_i32(v[31]);
    println_i32(copy[31]);
}
